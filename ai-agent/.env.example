GENAI_SERVICE_NAME=V-Energy Grid 360 GenAI
# Credencial Backend -> GenAI. Use o mesmo valor de AI_AGENT_SERVICE_API_TOKEN no Backend.
# Obrigatória fora de GENAI_ENVIRONMENT=local; nunca envie ao frontend.
# GENAI_SERVICE_API_TOKEN=
# O padrão é production e nega acesso sem identidade verificada.
# Para exercitar somente as fixtures locais, ative ambas as opções no .env privado:
# GENAI_ENVIRONMENT=local
# GENAI_ENABLE_DEMO_ACCESS=true
# Ative o adaptador opcional depois de instalar `python -m pip install -e ".[gemini]"`.
# O provedor permanece indisponível por padrão; não coloque uma chave real neste arquivo.
# GENAI_MODEL_PROVIDER=gemini
# Flash-Lite (menor custo/latência) ou Flash (mais capacidade geral):
# GENAI_GEMINI_MODEL=gemini-3.5-flash-lite
# GENAI_GEMINI_API_KEY=
# GENAI_MODEL_TIMEOUT_MS=20000
# Modelos Gemini secundários, tentados em ordem se o principal ficar indisponível.
# Use IDs válidos para sua conta; informe-os separados por vírgula ou como lista JSON.
# Todos usam o mesmo provedor e a mesma chave, então isso não cobre falhas gerais do Gemini.
# GENAI_GEMINI_FALLBACK_MODELS=modelo-secundario,modelo-terciario
# Groq (extra `groq`): pode ser o provedor principal ou um fallback de outro provedor.
# GENAI_GROQ_API_KEY=
# Confirme no console do Groq se o ID está disponível e aceita JSON mode.
# GENAI_GROQ_MODEL=openai/gpt-oss-120b
# Provedores tentados depois do principal, em ordem (gemini, groq); sem repetir o principal.
# GENAI_MODEL_FALLBACK_PROVIDERS=groq
# Prazo máximo de toda a cadeia de fallback, dentro do orçamento da requisição.
# GENAI_MODEL_TOTAL_TIMEOUT_MS=30000
# Roteamento de perguntas: desligado por padrão; limitado ao perfil/fonte sintéticos.
# Ao habilitar, configure GENAI_GEMINI_MODEL diferente do modelo leve.
# O insight de tela continua usando a cadeia principal/strong.
# Com GENAI_MODEL_FALLBACK_PROVIDERS=groq, o Groq é o fallback dos dois níveis.
# GENAI_MODEL_ROUTING_ENABLED=false
# Configure domínios permitidos em minúsculas, separados por vírgula ou lista JSON.
# O padrão vazio envia todas as perguntas ao nível strong.
# GENAI_MODEL_LIGHT_INTENTS=consumption
# Exemplo de níveis distintos: strong=gemini-3.6-flash; light=gemini-3.5-flash-lite.
# GENAI_MODEL_LIGHT_MODEL=gemini-3.5-flash-lite
# create_app rejeita roteamento fora de GRID360_DEMO_PROFILE + synthetic.fixture.
# Limites inclusivos da evidência serializada enviada ao modelo leve.
# GENAI_MODEL_LIGHT_MAX_EVIDENCE_RECORDS=50
# GENAI_MODEL_LIGHT_MAX_EVIDENCE_CHARS=8000
# Número máximo de modelos na cadeia (principal incluído), somando todos os provedores
# e os dois níveis do roteamento, e pausa inicial entre falhas transitórias.
# GENAI_MODEL_MAX_CALLS=3
# GENAI_FALLBACK_BACKOFF_MS=0
# Orçamento total da solicitação, prazo da fonte e limites de chamadas.
# GENAI_REQUEST_TIMEOUT_MS=30000
# GENAI_SOURCE_TIMEOUT_MS=10000
# GENAI_SOURCE_MAX_CALLS=1
# GENAI_EVIDENCE_MAX_ROWS=100
# GENAI_EVIDENCE_MAX_BYTES=16384
# Concorrência por processo para solicitações, fontes e modelos.
# GENAI_CONCURRENT_REQUESTS=16
# GENAI_CONCURRENT_SOURCES=8
# GENAI_CONCURRENT_MODELS=8
# Cache em memória da resposta gerada. TTL 0 mantém o cache desligado (padrão).
# Só guarda respostas fundamentadas após autorização; insights vindos do navegador não usam cache.
# GENAI_MODEL_CACHE_TTL_SECONDS=0
# GENAI_MODEL_CACHE_MAX_ENTRIES=256
# Só liga o smoke test real do Groq (tests/live); o serviço ignora esta variável.
# Use no ambiente do terminal junto com GENAI_GROQ_API_KEY, não no .env.
# GENAI_RUN_LIVE_SMOKE=1
