# Configurações do Backend (Copie para .env)
PROJECT_NAME="V-Energy Grid 360 API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Analytical endpoints fail closed unless a source is explicitly selected.
# "synthetic" enables the demonstration analytics (/kpis, /revenue, /panorama, /operations/continuity).
# O Compose de desenvolvimento seleciona synthetic pelo environment do serviço.
# Fora dele, habilite synthetic explicitamente para testar os dados fictícios.
ANALYTICS_SOURCE="unavailable"

# Conexão PostgreSQL (driver psycopg 3).
# Formato: postgresql+psycopg://<USUARIO>:<SENHA>@<HOST>:<PORTA>/<NOME_BANCO>
# Usuário, senha e banco devem coincidir com .env.db (raiz).
# Host "db" é o serviço do docker-compose; ao rodar o backend no host, use "localhost:5432".
# Os testes usam TEST_POSTGRES_URL explicitamente no ambiente do comando;
# ela deve apontar para outro banco descartável *_test, com usuário sem SUPERUSER.
DATABASE_URL="postgresql+psycopg://v_energy_app:senha_segura_grid360@db:5432/v_energy"

# Configurações de Pool de Conexões do PostgreSQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Caminho para os CSVs exportados da camada Gold (ou mocks locais)
GOLD_DATA_DIR="data/gold"

# CORS (Frontend Vite local por padrão)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Credenciais opcionais de serviço para as rotas operacionais de ordens.
# Sem configuração, acesso negado. Gere valores aleatórios distintos com pelo menos 32 caracteres.
# ORDERS_READ_TOKEN=<credencial-somente-leitura>
# ORDERS_WRITE_TOKEN=<credencial-de-escrita>
# Nunca use VITE_* nem envie essas credenciais ao bundle do navegador.
# BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Autenticação das ordens: service é exclusivo de desenvolvimento.
# O frontend/proxy não injeta credenciais; o cliente deve enviar Authorization.
APP_ENV=development
ORDERS_AUTH_MODE=service

# Para implantação, use APP_ENV=production e ORDERS_AUTH_MODE=oidc.
# Remova ORDERS_READ_TOKEN/ORDERS_WRITE_TOKEN nesse modo.
# Configure valores reais fornecidos pelo provedor OIDC da equipe (somente HTTPS):
# OIDC_ISSUER=https://identity.example.invalid/tenant
# OIDC_AUDIENCE=grid360-api
# OIDC_JWKS_URL=https://identity.example.invalid/tenant/jwks
# Tokens RS256 com exp/iat/sub/iss/aud, duração de até 1 h e scope orders:read/orders:write.
