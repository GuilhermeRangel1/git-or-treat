{
  "realm": "grid360",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "orders:read" },
      { "name": "orders:write" }
    ]
  },
  "clients": [
    {
      "clientId": "grid360-api",
      "name": "Grid 360 API resource",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "grid360-web",
      "name": "Grid 360 local web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173##http://127.0.0.1:5173"
      },
      "protocolMappers": [
        {
          "name": "Grid 360 API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "grid360-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "optionalClientScopes": ["orders:read", "orders:write"]
    }
  ],
  "clientScopes": [
    {
      "name": "orders:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "orders:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "users": [
    {
      "username": "reader",
      "firstName": "Local",
      "lastName": "Reader",
      "email": "reader@grid360.local",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["orders:read"],
      "credentials": [
        { "type": "password", "value": "__READER_PASSWORD__", "temporary": false }
      ]
    },
    {
      "username": "operator",
      "firstName": "Local",
      "lastName": "Operator",
      "email": "operator@grid360.local",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["orders:read", "orders:write"],
      "credentials": [
        { "type": "password", "value": "__OPERATOR_PASSWORD__", "temporary": false }
      ]
    }
  ]
}
