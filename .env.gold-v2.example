# Pasta exata que contém manifest.json e as 15 pastas CSV.
GOLD_CSV_V2_HOST_DIR=./backend/data/export_csv/REPLACE_RUN_ID/REPLACE_EXPORT_ID

# O override inicia a composição Gold do GenAI (app.gold_runtime).
# Configure também os arquivos locais ignorados pelo Git:
# backend/.env: GENAI_GOLD_DATABASE_URL (papel venergy_genai_reader provisionado),
# AI_AGENT_BASE_URL=http://ai-agent:8001, AI_AGENT_SERVICE_API_TOKEN,
# GENAI_AUDIT_WRITE_TOKEN e GENAI_GOLD_APPROVED_CONTROLS (somente controles aprovados).
# ai-agent/.env: GENAI_SERVICE_API_TOKEN (igual ao token técnico do Backend),
# GENAI_AUDIT_URL=http://backend:8000/api/v1/internal/genai-audit-events,
# GENAI_AUDIT_WRITE_TOKEN (igual ao token exclusivo de auditoria do Backend),
# GENAI_MODEL_PROVIDER=gemini e GENAI_GEMINI_API_KEY.
# Tokens técnico e de auditoria devem ser distintos. Nunca versionar valores privados.
